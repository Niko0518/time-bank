# TimeBank env 模板 —— Hermes × 云托管
# 复制为 .env（不要提交）或直接注入云托管环境变量。

# ---- 1) 腾讯云凭据（子账号、最小权限：仅用于【读 tb_* + 写 tb_ai_messages】数据通道）----
TC_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxx
TC_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDBASE_ENV_ID=cloud1-8gvjsmyd7860b4a3
CLOUDBASE_REGION=ap-shanghai

# ---- 2) 模型（CloudBase 资源点 OpenAI 兼容网关，与 timebankAI 一致的已验证通道）----
# 取法：控制台 → 环境 → 环境配置 → API Key → 创建（client_type=server）
CLOUDBASE_SERVER_API_KEY=xxxx-xxxx-xxxx-xxxx
# 默认可不填：自动拼 {env}.api.tcloudbasegateway.com/v1/ai/cloudbase/chat/completions
CLOUDBASE_AI_BASE=
CLOUDBASE_AI_MODEL=hy3

# ---- 3) 目标用户（报告归属的 _openid；TimeBank 主用户）----
# 取该用户在 tb_transaction/_openid 字段里的值
TARGET_USER_OPENID=xxxxxxxxxxxxxxxxxxxx

# ---- 4) 记忆备份到 COS（防容器回收清空）----
COS_BUCKET=xxx-1304758747         # 形如 <bucketname>-<appid>
COS_REGION=ap-shanghai
COS_MEMORY_PREFIX=hermes-memory   # 备份文件前缀
MEMORY_DIR=/data/hermes-memory    # 容器内记忆目录（启动恢复、定期备份）

# ---- 5) 服务 ---- 
PORT=9000